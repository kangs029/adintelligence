# Required for local application access. Replace this placeholder locally.
XPAT_ACCESS_PASSWORD=replace-with-a-strong-local-passphrase

# GitHub Personal Access Token — required only for deploy.mjs to connect Amplify.
# Generate at github.com/settings/tokens → Fine-grained → Contents read.
# Put this in .env.prod (gitignored), not here.
GITHUB_ACCESS_TOKEN=

# Optional runtime AI access. Vercel deployments can use platform OIDC instead.
AI_GATEWAY_API_KEY=

# Optional pipeline connectors.
CENSUS_API_KEY=

# Metabase — Ad Performance Attribution (Module B).
# XPAT's internal Metabase prod read database.
# URL: the base URL of the Metabase instance.
# API key: generated in Metabase Admin → Settings → Authentication → API Keys.
METABASE_URL=https://metabase-internal.xpat.money
METABASE_API_KEY=

# Mindcase API — Community Intelligence (Module A).
# Obtain from console.mindcase.co after sign-up. Key format: mk_live_...
# Replaces Reddit OAuth for community thread collection.
MINDCASE_API_KEY=

# Reddit OAuth — no longer required for community module (replaced by Mindcase).
# Kept here for reference only. Remove if not needed.
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# REDDIT_USER_AGENT="web:xpat-marketing-intelligence:v1.0 (contact: repository-maintainers)"

YOUTUBE_API_KEY=

# Meta Ads API — Ad Performance Intelligence (Module B).
# Obtain from XPAT's Meta Business Manager → System Users → Generate Token.
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=

# Google Ads API — Ad Performance Intelligence (Module B).
# Developer token from ads.google.com/aw/apicenter.
# OAuth credentials from console.cloud.google.com → APIs & Services → Credentials.
# Refresh token generated via OAuth 2.0 Playground (developers.google.com/oauthplayground).
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# Optional webhook-backed FX snapshot diagnostic.
CRON_SECRET=
FX_SNAPSHOT_WEBHOOK_URL=
